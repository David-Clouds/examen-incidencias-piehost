@model IEnumerable<IncidenciasBicicletas.Web.Models.Incidencia>

@{
    ViewData["Title"] = "Incidencias";
}

<h1>Incidencias abiertas con búsqueda y consulta rápida</h1>

<form method="get" asp-action="Index" class="row g-2 mb-4">
    <div class="col-md-4">
        <input type="text"
               name="termino"
               value="@ViewBag.Termino"
               class="form-control"
               placeholder="Buscar por estación o descripción..." />
    </div>

    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">✅ @TempData["Exito"]</div>
}

@if (!Model.Any())
{
    <p class="text-muted">No hay incidencias abiertas.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Estación</th>
                <th>Descripción</th>
                <th>Prioridad</th>
                <th>Fecha</th>

                @if (User.IsInRole("Supervisor"))
                {
                    <th></th>
                }
            </tr>
        </thead>

        <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td>@i.Estacion</td>
                    <td>@i.Descripcion</td>
                    <td>
                        <span class="badge bg-@(i.Prioridad == IncidenciasBicicletas.Web.Models.PrioridadIncidencia.Alta
                            ? "danger"
                            : i.Prioridad == IncidenciasBicicletas.Web.Models.PrioridadIncidencia.Media
                                ? "warning"
                                : "secondary")">
                            @i.Prioridad
                        </span>
                    </td>

                    <td>@i.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>

                    @if (User.IsInRole("Supervisor"))
                    {
                        <td>
                            <form asp-action="Cerrar"
                                  asp-route-id="@i.Id"
                                  method="post"
                                  class="d-inline">
                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger">
                                    Cerrar
                                </button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}