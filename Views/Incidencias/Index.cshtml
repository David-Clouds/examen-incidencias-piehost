@model IEnumerable<IncidenciasBicicletas.Web.Models.Incidencia>

@{
    ViewData["Title"] = "Incidencias";
}

<h1>Incidencias abiertas en tiempo real</h1>
<p id="estado-conexion" class="text-muted small">Conectando al canal en tiempo real...</p>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">✅ @TempData["Exito"]</div>
}

<table class="table table-striped" id="tabla-incidencias">
    <thead>
        <tr>
            <th>Estación</th>
            <th>Descripción</th>
            <th>Prioridad</th>
            <th>Fecha</th>
            @if (User.IsInRole("Supervisor"))
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var i in Model)
        {
            <tr id="fila-@i.Id">
                <td>@i.Estacion</td>
                <td>@i.Descripcion</td>
                <td>
                    <span class="badge bg-@(i.Prioridad == IncidenciasBicicletas.Web.Models.PrioridadIncidencia.Alta ? "danger" : i.Prioridad == IncidenciasBicicletas.Web.Models.PrioridadIncidencia.Media ? "warning" : "secondary")">
                        @i.Prioridad
                    </span>
                </td>
                <td>@i.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                @if (User.IsInRole("Supervisor"))
                {
                    <td>
                        <form asp-action="Cerrar" asp-route-id="@i.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cerrar</button>
                        </form>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        const clusterId = "free.blr2";
        const apiKey = "DnkS3FD9kPC6Y8XDrCphVE4GrWIg7AcEDHRfB7fb";
        const canal = "incidencias-canal";
        let socket;

        function conectar() {
            socket = new WebSocket(`wss://${clusterId}.piesocket.com/v3/${canal}?api_key=${apiKey}&notify_self=1`);

            socket.onopen = () => {
                document.getElementById("estado-conexion").innerText = "🟢 Conectado en tiempo real";
            };

            socket.onmessage = (evento) => {
                try {
                    const data = JSON.parse(evento.data);
                    if (data.tipo === "IncidenciaActualizada" && data.estado === "Cerrada") {
                        const fila = document.getElementById(`fila-${data.id}`);
                        if (fila) {
                            fila.remove();
                        }
                    }
                } catch (e) {
                    // ignorar mensajes de sistema (system:connected, etc.)
                }
            };

            socket.onclose = () => {
                document.getElementById("estado-conexion").innerText = "🔴 Reconectando...";
                setTimeout(reconectarYVerificar, 2000);
            };
        }

        async function reconectarYVerificar() {
            conectar();
            // Al reconectar, verificamos el estado vigente de cada fila visible
            document.querySelectorAll("tr[id^='fila-']").forEach(async (fila) => {
                const id = fila.id.replace("fila-", "");
                const respuesta = await fetch(`/Operaciones/Incidencias/Estado/${id}`);
                if (respuesta.ok) {
                    const data = await respuesta.json();
                    if (data.estado === "Cerrada") {
                        fila.remove();
                    }
                }
            });
        }

        conectar();
    </script>
}